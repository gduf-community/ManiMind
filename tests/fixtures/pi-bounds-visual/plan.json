  "facts": {
    "radius": "r=1 u；u为任意固定长度单位；a、b、L、U均无量纲",
    "definitions": {
      "a": "内接正n边形半边/r",
      "b": "内接正n边形边心距/r",
      "pi": "C/(2r)",
      "lower": "Ln=n*an",
      "upper": "Un=n*an/bn"
    },
    "seed": {
      "n": 6,
      "a": "1/2",
      "b": "sqrt(3)/2",
      "lower": "3",
      "upper": "2*sqrt(3)"
    },
    "recurrence": {
      "a_2n": "sqrt((1-bn)/2)",
      "b_2n": "sqrt((1+bn)/2)",
      "identity": "an^2+bn^2=1"
    },
    "geometric_chain": [
      "A、B为旧相邻顶点，H为AB中点，M为弧AB中点",
      "BH=an，OH=bn，OM=OB=1，所以HM=1-bn",
      "BM²=an²+(1-bn)²=1-bn²+1-2bn+bn²=2(1-bn)",
      "K为BM中点，等腰三角形OBM使OK垂直BM",
      "a2n=BK=BM/2；b2n=OK，由OK²+BK²=1得到两式；长度为正取正根"
    ],
    "circle_length_dependency": "沿用圆周长的通常几何意义及内接/外切正多边形夹逼定理；本片局部展示两界严格单调的理由，不重证任意多边形序列下弧长内禀性。Weisbart第2至4节给出严格化。",
    "arithmetic": "纯Fraction有理区间；isqrt给60位十进制格点根的下端与上端，全部递推端点向外传播；输出下界向下、上界向上。不使用math.pi/sin/cos/tan求数值界。",
    "rounding": "n=3072，七位向外舍入区间必须完整落入[3.141585,3.141595)；确认后五位四舍五入为3.14159，不声称π等于有限小数",
    "polygon_counts": [
      6,
