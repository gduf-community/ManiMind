    {
      "id": "N14",
      "cue": "flux",
      "focus": "swept_area_relation",
      "text": "新增面积是棒长乘这段位移。"
    },
    {
      "id": "N15",
      "cue": "flux",
      "focus": "signed_flux_relation",
      "text": "磁场向纸内，磁通变化取负号。"
