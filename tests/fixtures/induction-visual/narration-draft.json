    {
      "id": "N05",
      "cue": "separation",
      "focus": "electron_deflection",
      "text": "电子受磁场力向下偏，下端多电子，上端缺电子。"
    },
    {
      "id": "N06",
      "cue": "separation",
      "focus": "electric_balance",
      "text": "分开的电荷建立向下的电场，电场力把电子往上拉。"
    },
    {
      "id": "N07",
      "cue": "separation",
      "focus": "open_force_balance",
      "text": "达到稳态时，两种力大小相等。"
    },
    {
      "id": "N08",
      "cue": "voltage",
      "focus": "force_balance_before_cancel",
      "text": "两种力大小相等。"
    },
    {
      "id": "N09",
      "cue": "voltage",
      "focus": "field_relation",
      "text": "两边约去电荷量。"
    },
    {
      "id": "N10",
      "cue": "voltage",
      "focus": "voltage_from_field",
      "text": "电场强度乘棒长，就是两端电压。"
    },
    {
      "id": "N11",
      "cue": "voltage",
      "focus": "open_voltage_result_hold",
      "text": "代入电场强度，得到棒的开路电压。"
    },
    {
      "id": "N12",
      "cue": "flux",
      "focus": "closed_current",
      "text": "接通回路，两端电压推动电流。"
    },
    {
      "id": "N13",
      "cue": "flux",
      "focus": "swept_area_motion",
      "text": "棒走过一段距离，扫出一个长方形。"
