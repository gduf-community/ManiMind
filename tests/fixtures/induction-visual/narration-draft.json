    {
      "id": "N16",
      "cue": "flux",
      "focus": "faraday_substitution",
      "text": "电动势等于磁通变化率的负值。"
    },
    {
      "id": "N17",
      "cue": "flux",
      "focus": "motional_emf_relation",
      "text": "位移除以时间就是速度，又得到相同的电动势。"
    },
    {
      "id": "N18",
      "cue": "direction",
      "focus": "lenz_increasing",
      "text": "入纸磁通增加，感应磁场朝纸外，电流逆时针。"
