    {
      "id": "factor_to_roots",
      "operation": "solve_zero_factors",
      "source": "两个可见因子",
      "target": "各自=0与x=-1/1",
      "purpose": "保留因子来源和输入身份，不重教求导"
    },
    {
      "id": "roots_to_boundaries",
      "operation": "locate_real_axis",
      "source": "两根中的位置数值",
      "target": "数轴两个分界",
      "purpose": "位置不是函数值"
    },
    {
      "id": "left_factor_signs",
      "operation": "evaluate_factor_signs",
      "source": "x<-1时两因子",
      "target": "两负相乘>0和增",
      "purpose": "因子作用于整段"
    },
    {
      "id": "middle_factor_signs",
      "operation": "evaluate_factor_signs",
      "source": "-1<x<1时两因子",
      "target": "异号相乘<0和减",
      "purpose": "说明负号来路"
    },
    {
      "id": "right_factor_signs",
      "operation": "evaluate_factor_signs",
      "source": "x>1时两因子",
      "target": "两正相乘>0和增",
      "purpose": "不是有限曲线样本推全域"
    },
    {
      "id": "witness_to_quotient",
      "operation": "mean_value_identity",
      "source": "图上f(a),f(b),a,b及切线f'(c)",
      "target": "差商=f'(c)",
      "purpose": "先保留图上来源，再逐项送入中值定理"
    },
    {
      "id": "quotient_to_product",
      "operation": "multiply_positive_delta",
      "source": "差商等式",
      "target": "函数值差=f'(c)(b-a)",
      "purpose": "两因子分时移动避免交叉，b-a>0"
    },
    {
      "id": "positive_difference",
      "operation": "positive_product",
      "source": "正导数和正b-a",
      "target": "f(b)-f(a)>0",
      "purpose": "两正因子的积解释函数值差"
    },
    {
      "id": "difference_to_order",
      "operation": "compare_function_values",
      "source": "正的函数值差",
      "target": "a<b推出f(a)<f(b)",
      "purpose": "两函数值错峰换序，保留任意性与区间条件"
    }
  ],
