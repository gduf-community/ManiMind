  "audience": "会读函数坐标和直线斜率、会展开平方及非零约分，尚未系统学习导数的高中学生",
  "prior_knowledge": [
    {
      "lesson_id": "M02-02",
      "assumed_exit": "能将函数表达式、坐标点及图像对应",
      "if_unavailable": "首次出现P、Q时补足输入与输出对应，不在每一幕重讲函数定义"
    },
    {
      "lesson_id": "M09-01",
      "assumed_exit": "能用有向纵向增量除以横向增量求两点直线斜率",
      "if_unavailable": "用P(2,4)、Q(3,9)先建立同图增量比值，再进入缩小区间"
    },
    {
      "lesson_id": "M01-01",
      "assumed_exit": "能展开平方并在因子非零时约分",
      "if_unavailable": "保留展开、合并、提因式、非零约分的可见中间过程"
    }
  ],
  "understanding_goals": [
    "用有向输出增量/输入增量描述一段变化，它就是通过同两点的割线斜率；点的高度与变化率承担不同意义。",
    "固定P并让Q从两侧靠近，观察的是非零区间的比值如何变化，不是把两个点直接重合后做0/0。",
    "平方函数在x=2的所有非零小增量都给出4+h；差商距4恰为|h|，因此共同趋近值为4。",
    "f'(2)=4描述该点附近的一阶变化；可作邻近预测，但并未把抛物线变成直线。"
  ],
  "formula_transitions": [
    {
      "id": "average_ratio",
      "operation": "Form an output/input increment ratio",
      "source": "Visible Delta-y and Delta-x increment relations",
      "target": "Numerator Delta-y and denominator Delta-x of m",
      "purpose": "Connect the same graph increments to their distinct quotient roles"
    },
    {
      "id": "average_substitution",
      "operation": "Substitute the already displayed increment expressions",
      "source": "Delta-y=f(2+h)-4 and Delta-x=h",
      "target": "m=[f(2+h)-4]/h=5",
      "purpose": "Trace the actual output difference and input h from the retained increment equations"
    },
    {
      "id": "expanded",
      "operation": "Expand the square without inventing identity for newly produced terms",
      "source": "[(2+h)^2-4]/h",
      "target": "[4+4h+h^2-4]/h",
      "purpose": "Track the input h and subtracted 4 while new expansion terms appear as new terms"
    },
    {
      "id": "combined",
      "operation": "Cancel the equal constant terms",
      "source": "[4+4h+h^2-4]/h",
      "target": "[4h+h^2]/h",
      "purpose": "Retain complete history and transfer the surviving terms and denominator to the next equality"
    },
    {
      "id": "factored",
      "operation": "Factor the common numerator h",
      "source": "[4h+h^2]/h",
      "target": "h(4+h)/h",
      "purpose": "Transfer the common h before the reordered coefficient and remaining h, avoiding simultaneous crossing"
    },
    {
      "id": "simplified",
      "operation": "Cancel the nonzero common factor",
      "source": "h(4+h)/h with h!=0",
      "target": "4+h",
      "purpose": "Keep the nonzero condition and crossed factors readable while the surviving terms travel"
    },
    {
      "id": "general_position",
      "operation": "Promote the point-specific position to a general position",
      "source": "f'(2)=lim[f(2+h)-f(2)]/h=4",
