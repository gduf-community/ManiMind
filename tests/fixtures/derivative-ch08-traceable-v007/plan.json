  "formula_transitions": [
    {
      "id": "dimensions_into_volume",
      "operation": "substitute_dimensions",
      "source": "two distinct base dimensions and box height",
      "target": "V=(12-2x)(12-2x)x",
      "purpose": "dimensions remain independent roles even when bases are equal"
    },
    {
      "id": "equal_bases_to_square",
      "operation": "multiply_equal_factors",
      "source": "two equal whole base factors and height",
      "target": "V=x(12-2x)^2",
      "purpose": "one base stays, the second counts multiplicity; height moves as one factor"
    },
    {
      "id": "positive_domain",
      "operation": "solve_positive_dimensions",
      "source": "x>0 and 12-2x>0",
      "target": "0<x<6 cm",
      "purpose": "positive base gives strict upper bound and excludes degenerate boxes"
    },
    {
      "id": "product_rule_sources",
      "operation": "product_derivative",
      "source": "x and whole squared base in volume",
      "target": "x' times base square plus x times derivative of square",
      "purpose": "explicit differentiated and retained factors in both terms"
    },
    {
      "id": "outer_square_derivative",
      "operation": "outer_power_rule",
      "source": "squared inner function",
      "target": "2 times inner base times inner derivative",
      "purpose": "outer multiplicity and inner derivative have distinct roles"
    },
    {
      "id": "inner_derivative",
      "operation": "differentiate_inner_affine",
      "source": "(12-2x)'",
      "target": "(-2)",
      "purpose": "negative inner rate remains visible before multiplication"
    },
    {
      "id": "chain_coefficients_collect",
      "operation": "multiply_chain_coefficients",
      "source": "x times 2 times base times (-2)",
      "target": "negative 4x times base",
      "purpose": "sign and coefficient originate from the two derivative factors"
    },
    {
      "id": "extract_common_factor",
      "operation": "factor_common_whole_base",
      "source": "two products each containing 12-2x",
      "target": "(12-2x)[12-2x-4x]",
      "purpose": "two occurrences explicitly share one common factor, not a whole-line morph"
    },
    {
      "id": "combine_remainder",
      "operation": "collect_like_terms",
      "source": "12-2x-4x",
      "target": "12-6x",
      "purpose": "remainder changes locally, common factor survives"
    },
    {
      "id": "factor_signed_constants",
      "operation": "factor_two_affine_terms",
      "source": "12-2x and 12-6x",
      "target": "(-2)(x-6) and (-6)(x-2)",
      "purpose": "show both constants and corresponding root-bearing factors"
    },
    {
      "id": "two_negatives_and_factor_order",
      "operation": "multiply_constants_reorder_factors",
      "source": "(-2)(x-6)(-6)(x-2)",
      "target": "12(x-2)(x-6)",
      "purpose": "negative signs produce positive12 and factor identities exchange positions"
    },
    {
      "id": "factors_to_candidates",
      "operation": "zero_product_candidates",
      "source": "x-2 and x-6",
      "target": "x=2 and x=6",
      "purpose": "roots are derived from their own factors, not guessed by matching digits"
    },
    {
      "id": "feasible_candidate",
      "operation": "screen_domain",
      "source": "two algebraic roots and 0<x<6",
      "target": "only interior x=2, x=6 gives zero base",
      "purpose": "keep rejection reason while selecting feasible candidate"
    },
    {
      "id": "optimum_substitution",
      "operation": "substitute_selected_input",
      "source": "selected x=2 and volume objective",
      "target": "V(2)=2(12-2*2)^2",
      "purpose": "selected cut enters height and whole squared-base evaluation"
    },
    {
      "id": "optimum_evaluation",
      "operation": "evaluate_dimensions_and_volume",
      "source": "2(12-2*2)^2",
      "target": "2 times8 squared then128 cm cubed",
      "purpose": "result follows substitution, units retained"
    },
    {
      "id": "closing_rejection_relocation",
      "operation": "separate_old_rejection_and_current_result",
      "source": "old x2 excluded under min-height3",
      "target": "rejection below box, current x3/108 result in clear slot",
